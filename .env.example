PORT=4174
# anvil (local), kairos or base-sepolia
CHAIN=anvil
RPC_URL=http://127.0.0.1:8545
KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
COOP_ADDRESS=
DEVELOPER_ADDRESS=
REGISTRY_ADDRESS=
# Optional: AI reading of water-tube photos. Without it, values are entered by hand.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PADDYPAY_DATA_DIR=./data
# Created automatically in .env.local by ./run.sh demo. Keep private.
SIM_SEED=
